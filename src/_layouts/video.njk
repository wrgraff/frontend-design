---
layout: page.njk
---

{% from 'button.njk' import button %}
{% from 'label.njk' import label %}
{% from 'link.njk' import link %}
{% from 'section.njk' import section %}

{% set videoUrl = youtube_url or url %}
{% set videoCover = cover or '/img/publications/hero.png' %}
{% set videoCoverWidth = cover_width or 1400 %}
{% set videoCoverHeight = cover_height or 720 %}
{% set publicationsCollection = collections.publications or [] %}
{% set otherVideoItems = [] %}

{% for item in publicationsCollection %}
	{% if item.data.kind == 'video' and item.fileSlug != page.fileSlug %}
		{% set otherVideoItems = (otherVideoItems.push(item), otherVideoItems) %}
	{% endif %}
{% endfor %}

<article
	class="main__section video"
	data-video-url="{{ videoUrl }}"
	data-start="{{ start or 'false' }}"
>
	{% if tags and tags.length %}
		<ul class="video__tags">
			{% for item in tags %}
				<li class="video__tag">
					{{ label(
						text = item,
						size = 'm'
					) }}
				</li>
			{% endfor %}
		</ul>
	{% endif %}

	<div class="video__content">
		<picture class="video__media">
			<img
				class="video__img"
				src="{{ videoCover }}"
				alt=""
				aria-hidden="true"
				width="{{ videoCoverWidth }}"
				height="{{ videoCoverHeight }}"
				loading="lazy"
				decoding="async"
			>
		</picture>

		<div class="video__footer">
			{{ button(
				text = 'Play the video',
				mode = 'primary',
				size = 'l',
				iconLeft = 'video/play_circle',
				type = 'button',
				extraClass = 'video__button'
			) }}

			{{ link(
				text = 'Watch on YouTube',
				href = videoUrl,
				size = 'text-s',
				iconName = 'social-networks/youtube',
				external = true,
				extraClass = 'video__link'
			) }}
		</div>
	</div>

	<div class="video__body">
		<h1 class="video__heading">{{ heading or title }}</h1>
		{% if description %}
			<p class="video__description">{{ description }}</p>
		{% endif %}
	</div>
</article>

{% if otherVideoItems.length %}
	{% call section({
		pretitle: 'Speeches',
		heading: 'Other speaking videos'
	}) %}
		<ul class="publications">
			{% for publication in otherVideoItems %}
				{% set videoHref = publication.url %}
				{% set cardImage = publication.data.cover or '/img/publications/hero.png' %}
				{% set cardImageWidth = publication.data.cover_width or 681 %}
				{% set cardImageHeight = publication.data.cover_height or 744 %}
				<li class="publications__item">
					<picture class="publications__media">
						<img
							class="publications__image"
							src="{{ cardImage }}"
							alt=""
							aria-hidden="true"
							width="{{ cardImageWidth }}"
							height="{{ cardImageHeight }}"
							loading="lazy"
							decoding="async"
						>
					</picture>
					<div class="publications__content">
						<h3 class="publications__heading">
							{{ link(
								text = publication.data.heading,
								href = videoHref,
								size = 'heading-h6',
								iconName = ''
							) }}
						</h3>
						{% if publication.data.description %}
							<p class="publications__description">{{ publication.data.description }}</p>
						{% endif %}
					</div>
				</li>
			{% endfor %}
		</ul>
	{% endcall %}
{% endif %}

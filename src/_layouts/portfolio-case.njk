---
layout: page.njk
---

{% from 'case-hero.njk' import caseHero %}
{% from 'section.njk' import section %}
{% from 'content-list.njk' import contentList %}
{% from 'content-columns.njk' import contentColumns %}
{% from 'content-table.njk' import contentTable %}

{{ caseHero(
	hero = hero or {},
	heading = heading or '',
	description = description,
	role = role or '',
	area = area or '',
	tags = tags or []
) }}

{% if sections and sections.length %}
	{% for item in sections %}
		{% if item.content and item.content.length and item.content[0].type %}
			{% call section({
				pretitle: item.eyebrow or item.pretitle,
				heading: item.heading,
				lead: item.lead,
				content: '',
				tail: item.tail,
				decor_image: item.decor_image,
				decor_width: item.decor_width,
				decor_height: item.decor_height,
				decor_class: item.decor_class
			}) %}
				{% for contentItem in item.content %}
					{% if contentItem.type == 'content-list' %}
						{{ contentList(contentItem) }}
					{% elif contentItem.type == 'content-columns' %}
						{{ contentColumns(contentItem) }}
					{% elif contentItem.type == 'content-table' %}
						{{ contentTable(contentItem) }}
					{% endif %}
				{% endfor %}
			{% endcall %}
		{% else %}
			{{ section({
				pretitle: item.eyebrow or item.pretitle,
				heading: item.heading,
				lead: item.lead,
				content: item.content,
				tail: item.tail,
				decor_image: item.decor_image,
				decor_width: item.decor_width,
				decor_height: item.decor_height,
				decor_class: item.decor_class
			}) }}
		{% endif %}
	{% endfor %}
{% endif %}

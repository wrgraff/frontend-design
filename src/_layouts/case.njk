---
layout: page.njk
---

{% from 'case-hero.njk' import caseHero %}
{% from 'section.njk' import section %}

{% if sections and sections.length %}
	{{ caseHero(
		hero = hero or {},
		heading = heading or '',
		description = description,
		role = role or '',
		area = area or focus or '',
		tags = tags or []
	) }}

	{% for item in sections %}
		{{ section({
			pretitle: item.eyebrow or item.pretitle,
			heading: item.heading,
			lead: item.lead,
			content: item.content,
			decor_image: item.decor_image,
			decor_width: item.decor_width,
			decor_height: item.decor_height,
			decor_class: item.decor_class
		}) }}
	{% endfor %}
{% elif imgs and imgs.length %}
	<section class="main__section legacy-case">
		<ul class="legacy-case__list">
			{% for img in imgs %}
				<li class="legacy-case__item">
						{% if img.type == 'mp4' %}
							<video class="legacy-case__video" width="1400" height="900" controls muted loop>
							<source src="{{ page.url }}imgs/{{ img.name }}.mp4" type="video/mp4">
							Your browser does not support the video tag
						</video>
					{% else %}
						<picture class="legacy-case__picture">
							<img class="legacy-case__img" src="{{ page.url }}imgs/{{ img }}.png" alt="" width="1400" height="900">
						</picture>
					{% endif %}
				</li>
			{% endfor %}
		</ul>
	</section>
{% endif %}

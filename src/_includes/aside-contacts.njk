{% from 'link.njk' import link %}

<ul class="aside__contacts aside-contacts">
	{% for item in global.contacts.messaging %}
		<li class="aside-contacts__item">
			{{ link(
				text = item.heading,
				href = item.url,
				size = 'text-xs',
				iconName = item.icon
			) }}
		</li>
	{% endfor %}

	<li class="aside-contacts__divider" aria-hidden="true"></li>

	{% for item in global.contacts.socials %}
		<li class="aside-contacts__item">
			{{ link(
				text = item.heading,
				href = item.url,
				size = 'text-xs',
				iconName = item.icon
			) }}
		</li>
	{% endfor %}
</ul>

{% from 'icon.njk' import icon %}

{% macro button(
	text = 'Button',
	href = '',
	mode = '',
	size = '',
	subtext = '',
	iconLeft = '',
	iconRight = '',
	type = 'button',
	extraClass = '',
	download = false
) %}
	{% set classes = [
		'button',
		mode and 'button_mode_' + mode or '',
		size and 'button_size_' + size or '',
		extraClass
	] | join(' ') | trim %}
	{% set iconClasses = [
		'button__icon',
		mode == 'primary' and 'icon_inverse' or ''
	] | join(' ') | trim %}

	{% if href %}
		<a href="{{ href }}" class="{{ classes }}"{% if download %}{% if download == true %} download{% else %} download="{{ download }}"{% endif %}{% endif %}>
			{% if iconLeft %}
				{{ icon(iconLeft, iconClasses) }}
			{% endif %}

			{{ text }}

			{% if subtext %}
				<span class="button__subtext">{{ subtext }}</span>
			{% endif %}

			{% if iconRight %}
				{{ icon(iconRight, iconClasses) }}
			{% endif %}
		</a>
	{% else %}
		<button type="{{ type }}" class="{{ classes }}">
			{% if iconLeft %}
				{{ icon(iconLeft, iconClasses) }}
			{% endif %}

			<span class="button__text-wrap">
				<span class="button__text">{{ text }}</span>
				{% if subtext %}
					<span class="button__subtext">{{ subtext }}</span>
				{% endif %}
			</span>

			{% if iconRight %}
				{{ icon(iconRight, iconClasses) }}
			{% endif %}
		</button>
	{% endif %}
{% endmacro %}

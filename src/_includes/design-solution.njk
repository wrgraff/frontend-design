{% from 'slider.njk' import slider %}
{% from 'picture.njk' import picture %}

{% macro designSolution(data = {}) %}
	{% set images = data.images or [] %}
	{% set primaryDetails = data.primary or [] %}
	{% set secondaryDetails = data.secondary or [] %}
	{% set hasSlider = images and (images | length) > 1 %}
	{% set singleImage = images[0] if images and (images | length) == 1 else {} %}
	{% set singleImageDescription = (singleImage.description | default('') | trim) if singleImage else '' %}

	<div class="section__container-item design-solution">
		{% if images and (images | length) %}
			{% if hasSlider %}
				{{ slider(
					images = images,
					ariaLabel = 'Design solution slides',
					previousLabel = 'Previous slide',
					nextLabel = 'Next slide',
					extraClass = 'design-solution__slider'
				) }}
			{% elif singleImage %}
				{{ picture(
					image = singleImage,
					description = singleImageDescription,
					extraClass = 'design-solution__image-item'
				) }}
			{% endif %}
		{% endif %}

		{% if primaryDetails and (primaryDetails | length) %}
			<dl class="design-solution__details design-solution__details_role_primary description-list">
				{% for detail in primaryDetails %}
					<div class="description-list__item">
						{% if detail.heading %}
							<dt class="description-list__term">
								{{ detail.heading | trim }}
							</dt>
						{% endif %}
						{% if detail.content %}
							<dd class="description-list__description">
								{{ detail.content | markdown | safe }}
							</dd>
						{% endif %}
					</div>
				{% endfor %}
			</dl>
		{% endif %}

		{% if secondaryDetails and (secondaryDetails | length) %}
			<dl class="design-solution__details design-solution__details_role_secondary description-list">
				{% for detail in secondaryDetails %}
					<div class="description-list__item">
						{% if detail.heading %}
							<dt class="description-list__term">
								{{ detail.heading | trim }}
							</dt>
						{% endif %}
						{% if detail.items and (detail.items | length) %}
							<dd class="description-list__description">
								<ul class="design-solution__list list">
									{% for item in detail.items %}
										<li class="list__item">{{ item | markdown | safe }}</li>
									{% endfor %}
								</ul>
							</dd>
						{% elif detail.content %}
							<dd class="description-list__description">
								{{ detail.content | markdown | safe }}
							</dd>
						{% endif %}
					</div>
				{% endfor %}
			</dl>
		{% endif %}
	</div>
{% endmacro %}

{% from 'icon.njk' import icon %}

{% macro iconButton(
	iconName = 'api/api_file',
	href = '',
	mode = '',
	size = '',
	type = 'button',
	ariaLabel = 'Icon button',
	extraClass = '',
	dataAttrs = '',
	download = false
) %}
	{% set classes = [
		'icon-button',
		mode and mode != 'base' and 'icon-button_mode_' + mode or '',
		size and size != 'm' and 'icon-button_size_' + size or '',
		extraClass
	] | join(' ') | trim %}
	{% set iconClasses = [
		'icon-button__icon',
		mode == 'primary' and 'icon_inverse' or ''
	] | join(' ') | trim %}

	{% if href %}
		<a
			href="{{ href }}"
			class="{{ classes }}"
			aria-label="{{ ariaLabel }}"
			{{ dataAttrs | safe }}
			{% if download %}{% if download == true %} download{% else %} download="{{ download }}"{% endif %}{% endif %}
		>
			{{ icon(iconName, iconClasses) }}
		</a>
	{% else %}
		<button type="{{ type }}" class="{{ classes }}" aria-label="{{ ariaLabel }}" {{ dataAttrs | safe }}>
			{{ icon(iconName, iconClasses) }}
		</button>
	{% endif %}
{% endmacro %}

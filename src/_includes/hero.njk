{% from 'button.njk' import button %}

{% macro heroSection(hero) %}
<section class="main__section hero">
	{% if hero.image %}
		<div class="hero__img">
			<picture class="hero__picture">
				<img src="{{ hero.image }}" alt="{{ hero.image_alt or '' }}">
			</picture>
		</div>
	{% endif %}

	<h1 class="hero__heading">
		{{ (hero.heading | markdown | trim | replace('<p>', '') | replace('</p>', '')) | safe }}
	</h1>

	{% if hero.text %}
		<div class="hero__text">
			{{ hero.text | markdown | safe }}
		</div>
	{% endif %}

	{% if hero.cta and (hero.cta | length) %}
		<div class="hero__cta">
			{% for ctaItem in hero.cta %}
				{{ button(
					(ctaItem.text | default('Button') | markdown | trim | replace('<p>', '') | replace('</p>', '')) | safe,
					ctaItem.href or '',
					ctaItem.mode or 'secondary',
					ctaItem.size or 'xl',
					(ctaItem.subtext | default('') | markdown | trim | replace('<p>', '') | replace('</p>', '')) | safe,
					ctaItem.icon_left or '',
					ctaItem.icon_right or '',
					ctaItem.type or 'button',
					ctaItem.extra_class or '',
					ctaItem.download or false
				) }}
			{% endfor %}
		</div>
	{% endif %}
</section>
{% endmacro %}

{% from 'cta-item.njk' import ctaItem %}

{% macro section(data = {}) %}
	{% set sectionTail = data.tail or data.conclusion %}
	{% set sectionClasses = [
		'main__section',
		'section',
		data.extra_class or ''
	] | join(' ') | trim %}

	<section class="{{ sectionClasses }}"{% if data.id %} id="{{ data.id }}"{% endif %}>
		<header class="section__header">
			{% if data.pretitle %}
				<p class="section__eyebrow">
					{{ data.pretitle | trim }}
				</p>
			{% endif %}

			{% if data.heading %}
				<h2 class="section__heading">
					{{ data.heading | trim }}
				</h2>
			{% endif %}
		</header>

		{% if data.lead %}
			<div class="section__lead">
				{{ data.lead | markdown | safe }}
			</div>
		{% endif %}

		{% if data.content %}
			<div class="section__content">
				{{ data.content | markdown | safe }}
			</div>
		{% endif %}

		{% if caller %}
			{% set contentColumns = data.content_columns or '' %}
			<div class="section__container{% if contentColumns %} section__container_width_{{ contentColumns }}{% endif %}">
				{{ caller() }}
			</div>
		{% endif %}

		{% if sectionTail %}
			<div class="section__tail">
				{{ sectionTail | markdown | safe }}
			</div>
		{% endif %}

		{% if data.cta and (data.cta | length) %}
			<div class="section__cta">
				{% for item in data.cta %}
					{{ ctaItem(item, 'secondary', 'l', 'button') }}
				{% endfor %}
			</div>
		{% endif %}

		{% if data.decor_image and data.decor_width and data.decor_height %}
			<picture class="section__decor{% if data.decor_class %} {{ data.decor_class }}{% endif %}">
				<img
					class="section__decor-image"
					src="{{ data.decor_image }}"
					alt=""
					aria-hidden="true"
					width="{{ data.decor_width }}"
					height="{{ data.decor_height }}"
					loading="lazy"
					decoding="async"
				>
			</picture>
		{% endif %}
	</section>
{% endmacro %}

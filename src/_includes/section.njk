{% from 'button.njk' import button %}
{% from 'link.njk' import link %}

{% macro section(data = {}) %}
	{% set sectionClasses = [
		'main__section',
		'section',
		data.extra_class or ''
	] | join(' ') | trim %}

	<section class="{{ sectionClasses }}"{% if data.id %} id="{{ data.id }}"{% endif %}>
		<header class="section__header">
			{% if data.pretitle %}
				<p class="section__eyebrow">
					{{ data.pretitle | trim }}
				</p>
			{% endif %}

			{% if data.heading %}
				<h2 class="section__heading">
					{{ data.heading | trim }}
				</h2>
			{% endif %}
		</header>

		{% if data.lead %}
			<div class="section__lead">
				{{ data.lead | markdown | safe }}
			</div>
		{% endif %}

		{% if data.content or caller %}
			<div class="section__content">
				{% if data.content %}
					{{ data.content | markdown | safe }}
				{% endif %}
				{% if caller %}
					{{ caller() }}
				{% endif %}
			</div>
		{% endif %}

		{% if data.conclusion %}
			<div class="section__tail">
				{{ data.conclusion | markdown | safe }}
			</div>
		{% endif %}

		{% if data.cta and (data.cta | length) %}
			<div class="section__cta">
				{% for ctaItem in data.cta %}
					{% if ctaItem.kind == 'link' %}
						{{ link(
							text = ctaItem.text | default('Link') | trim,
							href = ctaItem.href or '',
							mode = ctaItem.mode or '',
							size = ctaItem.size or '',
							icon = ctaItem.icon or 'info-signs/link',
							external = ctaItem.external or false,
							target = ctaItem.target or '',
							rel = ctaItem.rel or '',
							extraClass = ctaItem.extra_class or ''
						) }}
					{% else %}
						{{ button(
							ctaItem.text | default('Button') | trim,
							ctaItem.href or '',
							ctaItem.mode or 'secondary',
							ctaItem.size or 'l',
							ctaItem.subtext | default('') | trim,
							ctaItem.icon_left or '',
							ctaItem.icon_right or '',
							ctaItem.type or 'button',
							ctaItem.extra_class or '',
							ctaItem.download or false
						) }}
					{% endif %}
				{% endfor %}
			</div>
		{% endif %}

		{% if data.decor_image and data.decor_width and data.decor_height %}
			<picture class="section__decor{% if data.decor_class %} {{ data.decor_class }}{% endif %}">
				<img
					class="section__decor-image"
					src="{{ data.decor_image }}"
					alt=""
					aria-hidden="true"
					width="{{ data.decor_width }}"
					height="{{ data.decor_height }}"
					loading="lazy"
					decoding="async"
				>
			</picture>
		{% endif %}
	</section>
{% endmacro %}

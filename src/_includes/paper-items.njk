{% from 'icon.njk' import icon %}

{% macro paperItems(
    list
) %}
	{% for item in list %}
		<li class="paper-list__item">
			{% if item.type %}
				{{ icon(item.type, 'paper-list__icon', 16) }}
			{% else %}
				<span class="paper-list__icon paper-list__icon_type_dash" aria-hidden="true"></span>
			{% endif %}
			{% if item.link %}
				<a href="{{ item.link }}" class="paper-list__link">
					<div class="paper-list__text">{{ item.heading | trim }}</div>
					{% if item.site %}
						<span class="paper-list__site">{{ item.site }}</span>
					{% endif %}
					{% if item.organisation and item.date %}
						<p class="paper-list__details">
							<span>{{ item.organisation }}</span>
							<span>{{ item.date }}</span>
						</p>
					{% endif %}
				</a>
			{% else %}
				<div class="paper-list__text">{{ item.heading | trim }}</div>
				{% if item.site %}
					<span class="paper-list__site">{{ item.site }}</span>
				{% endif %}
				{% if item.organisation and item.date %}
					<p class="paper-list__details">
						<span>{{ item.organisation }}</span>
						<span>{{ item.date }}</span>
					</p>
				{% endif %}
			{% endif %}
		</li>
	{% endfor %}
{% endmacro %}

{% from 'header.njk' import header with context %}
{% from 'portfolio-list.njk' import portfolioList with context %}


<main class="page__main main">
	{{ header( mainBlock = 'page' ) }}

	<section class="main__section promo" id="promo">
		<h1 class="promo__heading">{{ promo.heading }}</h1>
		<p class="promo__text">{{ promo.lead | safe }}</p>

		<div class="promo__buttons">
			<a href="{{ meta.cv }}" class="button button_secondary button_small_l button_medium_l button_large_xl button_ico_download">CV</a>
		</div>

		<div class="promo__video promo-video">
			<a class="promo-video__main-link" href="{{ promo.video.url }}" target="_blank" data-id="{{ promo.video.id }}">
				<p class="promo-video__text">{{ promo.video.description }}</p>
			</a>
			<button type="button" class="promo-video__button" aria-label="Launch the video"></button>
			<picture class="promo-video__media">
				<img class="promo-video__img" src="/img/{{ promo.video.cover }}" alt="">
			</picture>
		</div>
	</section>

	<section class="main__category category" id="now">
		<header class="category__header category-header">
			<h2 class="category-header__heading">{{ now.heading }}</h2>
			<div class="category-header__text">
				{{ now.text | markdown | safe }}
			</div>
		</header>

		<section class="category__section section">
			<div class="section__header">
				<h3 class="section__heading" data-category="{{ now.heading }}">{{ now.lastWorks.heading }}</h3>
				{% if now.lastWorks.comment %}
					<p class="section__comment">{{ now.lastWorks.comment }}</p>
				{% endif %}
			</div>

			{{ portfolioList(
				collection = collections.portfolio, slugList = now.lastWorks.works
			) }}
		</section>

		<section class="category__section section">
			<div class="section__header">
				<h3 class="section__heading" data-category="{{ now.heading }}">{{ now.designSystems.heading }}</h3>
				{% if now.designSystems.comment %}
					<p class="section__comment">{{ now.designSystems.comment }}</p>
				{% endif %}
			</div>

			<div class="section__text">
				{{ now.designSystems.text | markdown | safe }}
			</div>

			{{ portfolioList(
				collection = collections.portfolio, slugList = now.designSystems.works
			) }}
		</section>
	</section>

	<section class="main__category category" id="education">
		<header class="category__header category-header">
			<h2 class="category-header__heading">{{ education.heading }}</h2>
			<div class="category-header__text">
				{{ education.text | markdown | safe }}
			</div>

			<div class="category-header__list education-list">
				{% for item in education.list %}
					<div class="education-list__item">
						<h3 class="education-list__heading">{{ item.heading }}</h3>
						<p class="education-list__text">{{ item.place }}</p>
						<p class="education-list__year">{{ item.year }}</p>
					</div>
				{% endfor %}
			</div>
		</header>

		<section class="category__section section">
			<div class="section__header">
				<h3 class="section__heading" data-category="{{ education.heading }}">{{ education.additionalCourses.heading }}</h3>
				{% if education.additionalCourses.comment %}
					<p class="section__comment">{{ education.additionalCourses.comment }}</p>
				{% endif %}
			</div>

			<ul class="section__list education-list">
				{% for item in education.additionalCourses.list %}
					<li class="education-list__item">
						<h4 class="education-list__heading">{{ item.heading }}</h4>
						<p class="education-list__text">{{ item.place }}</p>
						<p class="education-list__year">{{ item.year }}</p>
					</li>
				{% endfor %}
			</ul>
		</section>
	</section>

	<section class="main__category category" id="frontend">
		<header class="category__header category-header">
			<h2 class="category-header__heading">{{ frontend.heading }}</h2>
			<div class="category-header__text">
				{{ frontend.text | markdown | safe }}
			</div>

			<div class="category-header__list education-list">
				{% if frontend.education.heading %}
					<p class="education-list__comment">{{ frontend.education.heading }}</p>
				{% endif %}
					<div class="education-list__item">
						<h3 class="education-list__heading">{{ frontend.education.course.heading }}</h3>
						<p class="education-list__text">{{ frontend.education.course.place }}</p>
						<p class="education-list__year">{{ frontend.education.course.year }}</p>
					</div>
			</div>
		</header>

		<section class="category__section section">
			<div class="section__header">
				<h3 class="section__heading" data-category="{{ frontend.heading }}">{{ frontend.education.heading }}</h3>
			</div>

			<p class="section__text">{{ frontend.education.course.place }} ({{ frontend.education.course.year }})</p>
			<p class="section__text">{{ frontend.education.course.heading }}</p>
		</section>
	</section>
</main>

{% from 'hero.njk' import heroSection %}

{{ heroSection(hero, meta.cv) }}

<section class="main__section">
	<p>{{ my_design_journey.pretitle }}</p>
	<h2>{{ my_design_journey.heading }}</h2>
	<p>{{ my_design_journey.body }}</p>
	<p>{{ my_design_journey.link_text }}</p>
</section>

<section class="main__section">
	<p>{{ portfolio.pretitle }}</p>
	<h2>{{ portfolio.heading }}</h2>
	<ul>
		{% for item in portfolio.items %}
			<li>
				<p>{{ item.role }}</p>
				<h3>{{ item.title }}</h3>
				<p>{{ item.description }}</p>
				<ul>
					{% for tag in item.tags %}
						<li>{{ tag }}</li>
					{% endfor %}
				</ul>
			</li>
		{% endfor %}
	</ul>
</section>

<section class="main__section">
	<p>{{ approach_to_work.pretitle }}</p>
	<h2>{{ approach_to_work.heading }}</h2>
	<p>{{ approach_to_work.intro }}</p>
	<ol>
		{% for step in approach_to_work.steps %}
			<li>
				<p>{{ step.label }}</p>
				<p>{{ step.text }}</p>
			</li>
		{% endfor %}
	</ol>
</section>

<section class="main__section">
	<p>{{ contacts.pretitle }}</p>
	<h2>{{ contacts.heading }}</h2>
	<p>{{ contacts.body }}</p>

	<h3>Locations</h3>
	<ul>
		{% for location in contacts.locations %}
			<li>{{ location }}</li>
		{% endfor %}
	</ul>

	<h3>Direct contacts</h3>
	<ul>
		{% for contact in contacts.direct_contacts %}
			<li>{{ contact }}</li>
		{% endfor %}
	</ul>

	<h3>Social links</h3>
	<ul>
		{% for link in contacts.social_links %}
			<li>{{ link }}</li>
		{% endfor %}
	</ul>
</section>

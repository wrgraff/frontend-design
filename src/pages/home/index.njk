{% from 'hero.njk' import heroSection %}
{% from 'section.njk' import section %}
{% from 'label.njk' import label %}
{% from 'link.njk' import link %}

{{ heroSection(hero) }}

{{ section({
	pretitle: my_design_journey.pretitle,
	heading: my_design_journey.heading,
	lead: my_design_journey.body,
	cta: my_design_journey.cta
}) }}

{% call section({
	pretitle: portfolio.pretitle,
	heading: portfolio.heading,
	lead: portfolio.lead
}) %}
	{% set portfolioCollection = collections.portfolio or [] %}
	{% if portfolioCollection.length %}
		<ul>
			{% for item in portfolioCollection %}
				{% if loop.index <= 4 %}
					<li>
						{% if item.data.role %}
							<p>{{ item.data.role }}</p>
						{% endif %}
				<h3>
					{{ link(
						text = item.data.title,
						href = item.url,
						size = 'xs',
						icon = ''
					) }}
				</h3>
						{% if item.data.description %}
							<p>{{ item.data.description }}</p>
						{% endif %}
						{% if item.data.tags and item.data.tags.length %}
							<ul>
								{% for tag in item.data.tags %}
									<li>{{ label(tag) }}</li>
								{% endfor %}
							</ul>
						{% endif %}
					</li>
				{% endif %}
			{% endfor %}
		</ul>
	{% else %}
		<p>{{ portfolio.empty_message }}</p>
	{% endif %}
{% endcall %}

{% call section({
	pretitle: approach_to_work.pretitle,
	heading: approach_to_work.heading,
	lead: approach_to_work.intro
}) %}
	<ol class="section__list list list_type_ordered list_columns_2">
		{% for step in approach_to_work.steps %}
			<li class="list__item"{% if step.label %} data-list-label="{{ step.label }}"{% endif %}>
				{{ step.text | markdown | safe }}
			</li>
		{% endfor %}
	</ol>
{% endcall %}

{% include 'contacts.njk' %}

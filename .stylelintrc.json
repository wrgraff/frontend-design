{
  "plugins": [
    "stylelint-order"
  ],
  "ignoreFiles": [
    "dist/**",
    "node_modules/**"
  ],
  "rules": {
    "property-no-unknown": [
      true,
      {
        "ignoreProperties": [
          "corner-shape"
        ]
      }
    ],
    "order/order": [
      "custom-properties",
      "declarations"
    ]
  }
}
